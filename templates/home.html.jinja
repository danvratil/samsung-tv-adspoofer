<!DOCTYPE html>
<html>
<head>
  <title>Samsung TV AdSpoofer</title>
  <style>
    .heading {

    }
    .upload {

    }
    .gallery {
        display: flex;
    }

    .gallery .image {
        max-width: 300px;
        width: 300px;
    }

  </style>
</head>
<body>
  <div class="heading">
    <h1>Samsung TV AdSpoofer</h1>
  </div>
  <div class="upload">
    <form method="POST" action="/images/" enctype="multipart/form-data">
      <label for="file">Picture:</label>
      <input type="file" name="file" accept="image/*" id="file" />

      <label for="name">Name (optional):</label>
      <input type="text" name="name" id="name" />

      <button type="submit">Upload</button>
    </form>
  </div>

  <div class="gallery">
  {% for picture in pictures %}
    <div class="image">
      <img src="/images/{{ picture.id }}" width="320" />
      {{ picture.name }} <form method="POST" action="images/{{ picture.id }}/delete"><button type="submit">Delete</button></form>
    </div>
  {% endfor %}
  </div>
</body>
</html>
